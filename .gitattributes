# Preserve the existing CRLF layout of these legacy modules.
booking/models.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
booking/serializers.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
booking/views.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Ubuntu deployment scripts must not acquire Windows CRLF line endings.
deploy/droplet/*.sh text eol=lf
.github/workflows/deploy_droplet.yml text eol=lf
