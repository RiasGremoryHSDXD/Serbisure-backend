{
    "version": 2,
    "regions": ["sin1"],
    "builds": [
        {
            "src": "Serbisure/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "includeFiles": "{booking,accounts}/assets/**"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "Serbisure/wsgi.py"
        }
    ]
}
