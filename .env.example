DATABASE_URL=postgresql://username:password@localhost:5432/serbisure
SECRET_KEY=your-django-secret-key
DJANGO_DEBUG=false
# Railway: supply the external PostgreSQL URL for your intended database privately.
# DATABASE_URL=postgresql://username:password@your-neon-host/serbisure-production-db?sslmode=require
REDIS_URL=redis://localhost:6379/0
REALTIME_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudinary Secrets
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# OCR & AI Verification Keys
# Google Cloud Vision API Key (REST endpoint image annotation)
GOOGLE_VISION_API_KEY=your_google_vision_api_key
# Groq API Key (Llama-3.3-70b structuring)
GROQ_API_KEY=your_groq_api_key

# Private Hugging Face token for review analysis (backend only)
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_SENTIMENT_SPACE_URL=https://riasgremory2-serbisure-sentiment-api.hf.space
